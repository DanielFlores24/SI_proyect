# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a Git.
# Las credenciales de GCP son ADC (impersonación local / cuenta adjunta en Cloud Run),
# así que aquí NO va ningún archivo JSON de clave.

GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
GOOGLE_CLOUD_LOCATION=us-central1
EMBEDDING_LOCATION=us-central1
GENERATION_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
TOP_K=6
MAX_OUTPUT_TOKENS=2048

# Acceso al chat: cambia estos dos valores por otros largos y distintos.
CHAT_PASSWORD=cambia-esta-contraseña
CHAT_SECRET=cambia-este-secreto-largo-y-aleatorio
SESSION_HOURS=8
MAX_PREGUNTAS=40
# En Cloud Run (HTTPS) poner 1 para que la cookie solo viaje por HTTPS.
COOKIE_SECURE=0
